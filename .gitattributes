# Normaliza a linha no repositório. O working tree segue com CRLF no Windows;
# só o que é gravado no git vira LF, que é o que o Pint e o CI esperam.
* text=auto eol=lf

# Fora do tarball de distribuição: nada abaixo tem uso em produção, mas sem isto
# tudo viaja no `composer require` de toda aplicação que instala o pacote. Afeta
# apenas o `composer archive`/dist — o clone do repositório continua completo.
#
# Note o que NÃO está aqui: `resources/js`, `resources/css`, `resources/views`,
# `stubs/` e `dist/` são publicados pelas tags api-key-frontend, api-key-views,
# api-key-build e api-key-assets. Excluí-los quebraria a customização do frontend
# e os assets da SPA para quem instala via Composer.
/.github               export-ignore
/.idea                 export-ignore
/tests                 export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/phpunit.xml           export-ignore
/pint.json             export-ignore
/phpstan.neon          export-ignore
/phpstan-baseline.neon export-ignore
/rector.php            export-ignore
