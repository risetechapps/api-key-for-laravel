includes:
    - vendor/larastan/larastan/extension.neon
    # Macros de schema do PostgreSQL (caseInsensitiveText e afins).
    - vendor/tpetry/laravel-postgresql-enhanced/phpstan-extension.neon

parameters:
    paths:
        - src
        - database

    # Nível 5: checa tipos de argumento e retorno, que é onde moram os erros que
    # esta base de código realmente produz — um findById() devolvendo ?Plan usado
    # sem checar null foi exatamente o bug de plano inativo desta auditoria.
    # Sem baseline: todo erro do nível vale, inclusive no código antigo. Subir
    # de nível é o próximo passo.
    level: 5

    # O Larastan deduz as colunas dos models pelas migrations. As do Address
    # vêm do pacote dele, fora de database/: sem isto, $user->address->city e
    # afins são propriedades desconhecidas.
    databaseMigrationsPath:
        - database/migrations
        - vendor/risetechapps/address-for-laravel/database/migrations

    # Um ignore que deixa de casar é código que mudou: avisa, para não ficar
    # silenciando nada.
    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Traits oferecidos ao app hospedeiro (scope de API key em models dele e
        # respostas JSON padronizadas). O pacote não os usa, e é isso que o
        # PHPStan aponta, mas removê-los quebraria quem os usa.
        -
            identifier: trait.unused
            paths:
                - src/Traits/HasApiKey.php
                - src/Traits/ApiResponseTrait.php
        # Docblock errado no SDK do Mercado Pago, não no nosso código.
        # RequestOptions::setCustomHeaders() está anotado como array<string,string>,
        # mas o valor termina em CURLOPT_HTTPHEADER (MPDefaultHttpClient:109), que
        # exige uma LISTA de 'Nome: valor' — é o formato que o próprio SDK monta em
        # MercadoPagoClient::addDefaultHeaders(). Passar par chave-valor faria o
        # array_merge de addCustomHeaders() produzir um item com chave string, e o
        # curl mandaria o valor sem o nome do header. A lista é o formato correto.
        -
            message: '#setCustomHeaders\(\) expects array<string, string>, array<int, string> given#'
            path: src/Traits/SendsIdempotentPayments.php
